//+------------------------------------------------------------------+
//|                                                   ZScore_Bot.mq5 |
//|                                  Statistical Mean Reversion Bot  |
//+------------------------------------------------------------------+
#property copyright "Generated by Antigravity"
#property link      ""
#property version   "1.00"

#include <Trade\Trade.mqh>
#include <Trade\SymbolInfo.mqh>
#include <Trade\PositionInfo.mqh>

//--- Input parameters
input int    InpMAPeriod       = 50;    // Moving Average Period
input double InpZScoreEntry    = 2.5;   // Z-Score Entry Threshold (e.g. 2.5 std devs)
input double InpRiskPercent    = 1.0;   // Risk per trade (% of balance)
input int    InpATRPeriod      = 14;    // ATR Period (for Stop Loss)
input double InpATRMultiplier  = 3.0;   // ATR Multiplier for Stop Loss

//--- Global variables
CTrade         trade;
CSymbolInfo    symInfo;
CPositionInfo  posInfo;

int            maHandle;
int            stdDevHandle;
int            atrHandle;
datetime       lastBarTime;

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   // Initialize symbol info
   if(!symInfo.Name(_Symbol))
     {
      Print("Failed to initialize symbol info");
      return(INIT_FAILED);
     }
   
   // Set up Moving Average (The Baseline)
   maHandle = iMA(_Symbol, _Period, InpMAPeriod, 0, MODE_SMA, PRICE_CLOSE);
   if(maHandle == INVALID_HANDLE)
     {
      Print("Failed to create MA indicator handle");
      return(INIT_FAILED);
     }

   // Set up Standard Deviation (The Volatility)
   stdDevHandle = iStdDev(_Symbol, _Period, InpMAPeriod, 0, MODE_SMA, PRICE_CLOSE);
   if(stdDevHandle == INVALID_HANDLE)
     {
      Print("Failed to create StdDev indicator handle");
      return(INIT_FAILED);
     }
     
   // Set up ATR (For dynamic Stop Loss based on fat tails)
   atrHandle = iATR(_Symbol, _Period, InpATRPeriod);
   if(atrHandle == INVALID_HANDLE)
     {
      Print("Failed to create ATR indicator handle");
      return(INIT_FAILED);
     }

   trade.SetExpertMagicNumber(1337); // Unique ID for our bot's trades
   
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   IndicatorRelease(maHandle);
   IndicatorRelease(stdDevHandle);
   IndicatorRelease(atrHandle);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // Only run logic once per bar (on close of the previous bar) to avoid intra-bar noise
   datetime currentBarTime = iTime(_Symbol, _Period, 0);
   if(currentBarTime == lastBarTime) return;
   
   // We have a new bar, get the data from the completely closed bar (index 1)
   double ma[], stdDev[], atr[], close[];
   CopyBuffer(maHandle, 0, 1, 1, ma);
   CopyBuffer(stdDevHandle, 0, 1, 1, stdDev);
   CopyBuffer(atrHandle, 0, 1, 1, atr);
   CopyClose(_Symbol, _Period, 1, 1, close);
   
   // Prevent division by zero if standard deviation is somehow flat
   if(stdDev[0] == 0.0) return;
   
   // 1. Calculate the Statistical Signal (Z-Score)
   double zScore = (close[0] - ma[0]) / stdDev[0];
   
   // Update symbol prices
   symInfo.RefreshRates();
   
   // Check if we have an open position
   bool hasPosition = PositionSelect(_Symbol);
   
   if(hasPosition)
     {
      long posType = PositionGetInteger(POSITION_TYPE);
      
      // Exit Logic: Mean Reversion
      // If we are LONG and the Z-Score hits 0 (reverted to mean)
      if(posType == POSITION_TYPE_BUY && zScore >= 0.0)
        {
         trade.PositionClose(_Symbol);
         lastBarTime = currentBarTime;
         Print("Mean Reverted: Closed LONG. Z-Score hit 0.");
        }
      // If we are SHORT and the Z-Score hits 0 (reverted to mean)
      else if(posType == POSITION_TYPE_SELL && zScore <= 0.0)
        {
         trade.PositionClose(_Symbol);
         lastBarTime = currentBarTime;
         Print("Mean Reverted: Closed SHORT. Z-Score hit 0.");
        }
     }
   else
     {
      // Entry Logic
      // LONG ENTRY: Price is unusually low (Crashed below normal variance)
      if(zScore <= -InpZScoreEntry)
        {
         double slDistance = atr[0] * InpATRMultiplier;
         double slPrice = symInfo.Ask() - slDistance;
         double lotSize = CalculateLotSize(slDistance);
         
         if(lotSize > 0 && trade.Buy(lotSize, _Symbol, symInfo.Ask(), slPrice, 0.0, "Z-Score Mean Reversion Long"))
           {
            lastBarTime = currentBarTime;
            PrintFormat("Opened LONG. Z-Score: %.2f", zScore);
           }
        }
      // SHORT ENTRY: Price is unusually high (Pumped above normal variance)
      else if(zScore >= InpZScoreEntry)
        {
         double slDistance = atr[0] * InpATRMultiplier;
         double slPrice = symInfo.Bid() + slDistance;
         double lotSize = CalculateLotSize(slDistance);
         
         if(lotSize > 0 && trade.Sell(lotSize, _Symbol, symInfo.Bid(), slPrice, 0.0, "Z-Score Mean Reversion Short"))
           {
            lastBarTime = currentBarTime;
            PrintFormat("Opened SHORT. Z-Score: %.2f", zScore);
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Calculate dynamic lot size based on account risk                 |
//+------------------------------------------------------------------+
double CalculateLotSize(double slDistance)
  {
   double accountBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   double riskAmount = accountBalance * (InpRiskPercent / 100.0);
   
   double tickSize = symInfo.Point();
   double tickValue = symInfo.TickValue();
   
   if(tickSize == 0 || tickValue == 0 || slDistance == 0) return 0.0;
   
   // How many ticks is our Stop Loss?
   double slTicks = slDistance / tickSize;
   
   // Calculate Lot Size: Risk Amount / (SL Ticks * Value per tick for 1 lot)
   double lotSize = riskAmount / (slTicks * tickValue);
   
   // Normalize lot size to broker's allowed steps
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   
   lotSize = MathRound(lotSize / lotStep) * lotStep;
   
   if(lotSize < minLot) lotSize = minLot;
   if(lotSize > maxLot) lotSize = maxLot;
   
   return lotSize;
  }
//+------------------------------------------------------------------+
